# Normalise line endings to LF on checkout for all text files
* text=auto eol=lf

# Web source files – explicitly mark as text
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.svg     text eol=lf

# Git config files
.gitignore      text eol=lf
.gitattributes  text eol=lf

# Binary files – do not mangle
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.eot    binary
